# AIOS environment template
# Copy to .env.local for local development. Never commit real credentials.
# Blank optional values keep their integrations disabled or fail-closed.

# Application
# Canonical HTTPS origin for authentication callbacks and public links.
# Local development may leave this blank to use the request origin.
APP_BASE_URL=https://crm.example.com

# Supabase
# The public values are safe for browser use. Prefer a publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional server URL alias used by seed and verification scripts. It is
# normally identical to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Encryption and protected workers
# Base64url/Base64 or hexadecimal encoded 32-byte AES key. Keep this stable
# across every app and worker instance; rotation requires an envelope migration.
TENANT_INTEGRATION_ENCRYPTION_KEY=

# Independent high-entropy secrets, each 32-512 characters.
AIOS_WORKER_SECRET=
EMAIL_INBOUND_WORKER_SECRET=

# Maximum AIOS runs allowed per organization per UTC day (default: 200).
AIOS_MAX_DAILY_RUNS_PER_ORGANIZATION=200

# Platform release gates
# Comma-separated server-enforced modules. Leave blank to disable all.
# Valid values: billing, usage_governance, incident_operations,
# feature_rollouts, support_access, portfolio_analytics.
PLATFORM_RELEASES=

# Keep false in production. Enables only the zero-money sandbox adapter.
PAYMENT_SANDBOX_ENABLED=false

# Platform email (Resend fallback)
# Tenant-owned mail credentials are configured inside the application.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=AIOS Travel <travel@example.com>
RESEND_REPLY_TO_EMAIL=travel@example.com

# AI model router
# Providers without credentials remain unavailable. The priority list is also
# filtered through each workspace's provider allow-list.
AIOS_MODEL_PROVIDER=groq
AIOS_MODEL_PROVIDER_PRIORITY=groq,glm,nvidia,openrouter,openai,anthropic,gemini,qwen

GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

ZHIPU_API_KEY=
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

OPENAI_API_KEY=
AIOS_OPENAI_MODEL=gpt-5.6-terra

GEMINI_API_KEY=
AIOS_GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
AIOS_ANTHROPIC_MODEL=claude-sonnet-4-6

QWEN_API_KEY=
AIOS_QWEN_BASE_URL=
AIOS_QWEN_MODEL=qwen-plus

# Legacy GLM aliases retained during migration.
AIOS_GLM_API_KEY=
AIOS_GLM_BASE_URL=
AIOS_GLM_MODEL=glm-4.7-flash

# Development fixtures and verification (optional)
# Enables destructive, self-cleaning authenticated Playwright fixtures. Use
# only with a local or dedicated test Supabase project.
RUN_AUTHENTICATED_E2E=false

# Target organization for `npm run seed:mvp-demo` when selection is ambiguous.
SEED_ORGANIZATION_ID=

# Remote test targets require their matching explicit opt-in.
WEBHOOK_TEST_BASE_URL=
ALLOW_EXTERNAL_WEBHOOK_TEST=false
LOAD_SMOKE_BASE_URL=
ALLOW_EXTERNAL_LOAD_SMOKE=false

# Load-smoke defaults and accepted bounds are enforced by the runner.
LOAD_SMOKE_HEALTH_REQUESTS=240
LOAD_SMOKE_BOUNDARY_REQUESTS=80
LOAD_SMOKE_CONCURRENCY=16
LOAD_SMOKE_REQUEST_TIMEOUT_MS=5000
LOAD_SMOKE_HEALTH_P95_MS=750
LOAD_SMOKE_BOUNDARY_P95_MS=2000
