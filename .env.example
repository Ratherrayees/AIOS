# Public Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical HTTPS origin used in authentication email callbacks.
# Local development may omit this and uses the local request origin.
APP_BASE_URL=https://crm.example.com

# Keep omitted/false in production. Enable only in an isolated test deployment
# to expose the zero-money sandbox payment adapter and simulation checkout.
PAYMENT_SANDBOX_ENABLED=false

# Server-only Supabase credential
SUPABASE_SECRET_KEY=

# Base64/Base64url or hex encoded 32-byte AES key used only for per-tenant
# integration credentials. Generate once, back it up securely, and keep the
# same value across every app and worker instance. Rotating it requires a
# credential-envelope migration.
TENANT_INTEGRATION_ENCRYPTION_KEY=

# Server-only Resend credentials (after your sending domain is verified)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=AIOS Travel <travel@lumierah.in>
RESEND_REPLY_TO_EMAIL=travel@lumierah.in

# Server-only AIOS model router. Omit credentials to keep all model runs fail-closed.
# The priority chain is used only after a transient provider failure and is
# always filtered through the workspace provider allow-list.
AIOS_WORKER_SECRET=
EMAIL_INBOUND_WORKER_SECRET=
AIOS_MODEL_PROVIDER=groq
AIOS_MODEL_PROVIDER_PRIORITY=groq,glm,nvidia,openrouter,openai,anthropic,gemini,qwen
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
ZHIPU_API_KEY=
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# Legacy GLM aliases remain supported during migration.
AIOS_GLM_API_KEY=
AIOS_GLM_BASE_URL=
AIOS_GLM_MODEL=glm-4.7-flash

# Production choices: set AIOS_MODEL_PROVIDER and only the matching credential.
OPENAI_API_KEY=
AIOS_OPENAI_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
AIOS_GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
AIOS_ANTHROPIC_MODEL=claude-sonnet-4-6
QWEN_API_KEY=
AIOS_QWEN_BASE_URL=
AIOS_QWEN_MODEL=qwen-plus
